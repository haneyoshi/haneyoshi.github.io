---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="YuShan Hung | Software Developer"
  description="YuShan Hung is a software developer with experience across IT operations, data reporting, workflow analysis, and automation."
>
  <section class="hero container" aria-labelledby="page-title">
    <div class="hero-content">
      <p class="eyebrow">Hello, I'm YuShan.</p>
      <h1 id="page-title">Software Developer</h1>
      <p class="hero-summary">
        I build practical software and approach technical problems with experience spanning IT
        operations, data reporting, workflow analysis, and automation.
      </p>
      <div class="hero-actions" aria-label="Portfolio actions">
        <a class="action action-primary" href="#projects">View my work</a>
        <a class="action action-secondary" href="#contact">Contact me</a>
      </div>
    </div>
  </section>

  <section id="about" class="about container" aria-labelledby="about-title">
    <div class="about-content">
      <h2 id="about-title">About</h2>
      <p class="about-introduction">
        I am a software developer with a Bachelor’s degree in Applied Computer Science and current
        experience as an IT Operations Analyst. My work and projects have developed my interest in
        the connection between software, data, systems, and the day-to-day workflows they support.
      </p>
      <div class="about-supporting">
        <p>
          I enjoy breaking down technical problems, organizing requirements, and turning ideas into
          practical implementations. My experience includes IT operations, data reporting, workflow
          analysis, automation, and application development. I am continuing to strengthen my
          full-stack development skills through focused projects and the rebuild of this portfolio.
        </p>
        <p>
          I am interested in junior-level and related opportunities where I can contribute careful
          analysis, dependable technical work, and a willingness to keep learning across software
          and systems.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-section);
  }

  .hero-content {
    max-width: 52ch;
  }

  .about {
    padding-bottom: var(--space-major);
    scroll-margin-top: var(--space-lg);
  }

  .about-content {
    max-width: 68ch;
  }

  .about h2 {
    margin: 0;
    font-size: var(--font-size-section);
    line-height: 1.15;
  }

  .about-introduction {
    max-width: 52ch;
    margin: var(--space-lg) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    line-height: 1.55;
  }

  .about-supporting {
    max-width: 68ch;
    margin-top: var(--space-xl);
    color: var(--color-text-secondary);
  }

  .about-supporting p {
    margin: 0;
  }

  .about-supporting p + p {
    margin-top: var(--space-md);
  }

  .eyebrow {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
    font-weight: 600;
  }

  h1 {
    margin: 0;
    font-size: var(--font-size-display);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero-summary {
    margin: var(--space-lg) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-lg);
  }

  .action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-lg);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-sm);
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
  }

  .action-primary {
    background: var(--color-accent);
    color: var(--color-surface);
  }

  .action-primary:hover {
    border-color: var(--color-accent-hover);
    background: var(--color-accent-hover);
    color: var(--color-surface);
  }

  .action-primary:active {
    border-color: var(--color-accent-active);
    background: var(--color-accent-active);
    color: var(--color-surface);
    transform: translateY(1px);
  }

  .action-secondary {
    color: var(--color-accent);
  }

  .action-secondary:hover {
    border-color: var(--color-accent-hover);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
  }

  .action-secondary:active {
    border-color: var(--color-accent-active);
    color: var(--color-accent-active);
    transform: translateY(1px);
  }

  @media (max-width: 23rem) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
