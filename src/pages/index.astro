---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import echoTaskDashboardImage from '../../images/EchoTask_DashBoard.png';
import echoTaskAvailabilityImage from '../../images/EchoTask_worker Availability.png';
import mediCheckDashboardImage from '../../images/MediCheck_Dashboard.png';
import mediCheckConsultationImage from '../../images/MediCheck_Consultation_Symptoms.png';
---

<BaseLayout
  title="YuShan Hung | Software Developer"
  description="YuShan Hung is a software developer with experience across IT operations, data reporting, workflow analysis, and automation."
>
  <section class="hero container" aria-labelledby="page-title">
    <div class="hero-content">
      <p class="eyebrow">Software · Systems · Practical problem-solving</p>
      <h1 id="page-title">Software Developer</h1>
      <p class="hero-summary">
        I build practical software and approach technical problems with experience spanning IT
        operations, data reporting, workflow analysis, and automation.
      </p>
      <nav id="contact" class="hero-contact" aria-label="Contact links">
        <ul>
          <li>
            <a
              href="https://github.com/haneyoshi"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub — opens in a new tab"
            >GitHub</a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/yushan-hung-266273212/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn — opens in a new tab"
            >LinkedIn</a>
          </li>
          <li>
            <button
              id="copy-email"
              class="copy-email"
              type="button"
              data-email="pokemonbotno001@gmail.com"
            >Copy email</button>
          </li>
        </ul>
        <p id="copy-email-status" class="copy-email-status" aria-live="polite" aria-atomic="true"></p>
        <p id="copy-email-fallback" class="copy-email-fallback" hidden>
          Email: <span>pokemonbotno001@gmail.com</span>
        </p>
        <noscript>
          <p class="copy-email-fallback">Email: <span>pokemonbotno001@gmail.com</span></p>
        </noscript>
      </nav>
    </div>
  </section>

  <section id="about" class="about container" aria-labelledby="about-title">
    <div class="about-content">
      <p class="section-label">Profile</p>
      <h2 id="about-title">About</h2>
      <p class="about-introduction">
        I am a software developer with a Bachelor’s degree in Applied Computer Science, currently
        working as an IT Operations Analyst. My work and projects have developed my interest in
        the connection between software, data, systems, and the day-to-day workflows they support.
      </p>
      <div class="about-supporting">
        <p>
          I enjoy breaking down technical problems, organizing requirements, and turning ideas into
          practical implementations. My experience includes IT operations, data reporting, workflow
          analysis, automation, and application development. I am continuing to strengthen my
          full-stack development skills through focused projects and the rebuild of this portfolio.
        </p>
        <p>
          I am interested in junior-level and related opportunities where I can contribute careful
          analysis, dependable technical work, and a willingness to keep learning across software
          and systems.
        </p>
      </div>
    </div>
  </section>

  <section id="projects" class="projects container" aria-labelledby="projects-title">
    <div class="projects-heading">
      <p class="section-label">Selected work</p>
      <h2 id="projects-title">Projects</h2>
      <p class="projects-introduction">
        These projects show how I approach software development through practical problem
        definition, structured data, interface design, and iterative implementation. Each project
        is presented according to its current scope and maturity, without overstating completion or
        real-world use.
      </p>
    </div>

    <article id="medicheck" class="medicheck" aria-labelledby="medicheck-title">
      <header class="medicheck-header">
        <h3 id="medicheck-title">MediCheck</h3>
        <p class="project-metadata">
          Educational desktop software prototype <span aria-hidden="true">·</span> Solo project
          <span aria-hidden="true">·</span> Built 2024 <span aria-hidden="true">·</span>
          Redesigned 2026
        </p>
      </header>

      <div class="medicheck-summary">
        <p>
          MediCheck is a Python, Tkinter/ttk, and MySQL educational clinic-workflow prototype that I
          originally built in 2024 and substantially redesigned in 2026. The current application
          follows one continuous workflow from patient check-in and queue management through
          consultation, transactional visit completion, and historical record retrieval.
        </p>
        <p class="project-technology"><strong>Technology:</strong> Python, Tkinter/ttk, MySQL</p>
      </div>

      <figure class="medicheck-figure medicheck-figure-dashboard">
        <Image
          src={mediCheckDashboardImage}
          alt="Redesigned MediCheck Dashboard showing the persistent application shell and clinic workflow overview."
          width={1119}
          height={749}
          sizes="(max-width: 64rem) calc(100vw - 2rem), 60vw"
          format="png"
        />
        <figcaption>
          <strong>Clinic workflow overview</strong> — The redesigned application shell brings queue
          status, patient actions, and current clinic activity into one consistent workspace.
        </figcaption>
      </figure>

      <div class="medicheck-details">
        <section aria-labelledby="medicheck-workflow-title">
          <h4 id="medicheck-workflow-title">Workflow redesign</h4>
          <p>
            I redesigned the original popup-heavy, debug-style interface as a persistent
            multi-workspace application shell with clear navigation and integrated patient
            workflows. Consultation is one four-stage experience—Symptoms, Diagnosis, Prescription,
            and Review—that keeps patient context and confirmed selections visible. This preserved
            useful backend behavior while improving the existing application instead of
            unnecessarily rewriting it.
          </p>
        </section>

        <section aria-labelledby="medicheck-data-title">
          <h4 id="medicheck-data-title">Relational data and SQL</h4>
          <p>
            Patients, visits, symptoms, diagnoses, prescriptions, and medicines are represented as
            related data. Historical records support SQL-driven symptom, diagnosis, and medicine
            suggestions through relational associations, aggregation, frequency analysis, and
            ranking. This is not a trained machine-learning model or medically validated AI.
          </p>
        </section>

        <section aria-labelledby="medicheck-reliability-title">
          <h4 id="medicheck-reliability-title">Reliability and state</h4>
          <p>
            Visit completion persists the complete logical case in one database transaction. If
            persistence fails, the transaction rolls back and consultation state remains available
            for retry. State clears only after successful completion, and duplicate completion is
            guarded against. The redesign also strengthened validation and state-lifecycle handling.
          </p>
        </section>
      </div>

      <figure class="medicheck-figure medicheck-figure-consultation">
        <Image
          src={mediCheckConsultationImage}
          alt="MediCheck consultation Symptoms stage showing confirmed selections and related suggestions."
          width={1113}
          height={746}
          sizes="(max-width: 64rem) calc(100vw - 2rem), 60vw"
          format="png"
        />
        <figcaption>
          <strong>Guided consultation workflow</strong> — A four-stage consultation keeps patient
          context and confirmed selections visible while historical relational data surfaces related
          suggestions.
        </figcaption>
      </figure>

      <a class="action action-primary medicheck-action" href="https://github.com/haneyoshi/MediCheck">
        View MediCheck on GitHub
      </a>
    </article>

    <article id="echotask" class="echotask" aria-labelledby="echotask-title">
      <div class="echotask-text">
        <header>
          <h3 id="echotask-title">EchoTask</h3>
          <p class="project-metadata">
            Completed full-stack MVP <span aria-hidden="true">·</span> Solo project
          </p>
        </header>

        <div class="echotask-content">
          <p>
            EchoTask is a full-stack operations-coordination MVP for daily caretaking and facilities
            workflows. It brings attendance, worker availability, area coverage, temporary
            assignments, events, Snow Logs, supply requests, and account management into one
            role-aware system.
          </p>

          <div class="echotask-evidence">
            <section>
              <h4>End-to-end implementation</h4>
              <p>
                I designed and implemented the relational model, Flask backend, authenticated JSON
                APIs, business rules, React frontend, and role-aware Worker, Coordinator, and
                Supervisor workflows.
              </p>
            </section>

            <section>
              <h4>Design decisions</h4>
              <p>
                Permanent worker-area assignments remain separate from temporary daily coverage,
                private absence reasons are separated from general operational availability, and
                important relationships use structured relational data. Backend authorization
                independently enforces role permissions.
              </p>
            </section>

            <section>
              <h4>Validation</h4>
              <p>
                Cookie-based Flask sessions, validation and edge-state handling, and integrated
                frontend/backend workflows were verified alongside a documented backend checkpoint
                of 52 passing tests.
              </p>
            </section>
          </div>

          <p class="project-technology">
            <strong>Technology:</strong> React, Flask, SQLAlchemy, SQLite
          </p>
        </div>

        <a class="action action-secondary echotask-action" href="https://github.com/haneyoshi/WebAppMVP">
          View EchoTask on GitHub
        </a>
      </div>

      <div class="echotask-visuals" aria-label="EchoTask interface evidence">
        <figure class="echotask-figure">
          <Image
            src={echoTaskDashboardImage}
            alt="EchoTask coordinator Dashboard showing building coverage and details for the selected Agriculture Building."
            width={1217}
            height={878}
            sizes="(max-width: 48rem) calc(100vw - 4rem), (max-width: 72rem) calc(100vw - 8rem), 960px"
            format="png"
          />
          <figcaption>
            Daily coverage overview — Coordinators can review worker availability, regular area
            ownership, and temporary coverage across buildings from a shared operational dashboard.
          </figcaption>
        </figure>

        <figure class="echotask-figure">
          <Image
            src={echoTaskAvailabilityImage}
            alt="EchoTask coordinator Attendance page showing team statuses, including a worker assigned elsewhere while officially working."
            width={1192}
            height={873}
            sizes="(max-width: 48rem) calc(100vw - 4rem), (max-width: 72rem) calc(100vw - 8rem), 960px"
            format="png"
          />
          <figcaption>
            Attendance and availability — EchoTask keeps official attendance separate from
            operational availability, allowing a worker to remain checked in while temporarily
            assigned elsewhere.
          </figcaption>
        </figure>
      </div>
    </article>
  </section>

  <section id="experience" class="experience-education container" aria-labelledby="experience-title">
    <p class="section-label">Background</p>
    <h2 id="experience-title">Experience and Education</h2>

    <div class="experience-education-pair">
      <article class="experience-education-entry">
        <h3>Experience</h3>
        <h4>IT Operations Analyst</h4>
        <p class="experience-education-metadata">June 2025–Present</p>
        <p>
          Current technical role involving IT operations, data reporting, workflow analysis,
          automation, and technical problem-solving.
        </p>
      </article>

      <article class="experience-education-entry">
        <h3>Education</h3>
        <h4>Bachelor’s degree in Applied Computer Science</h4>
        <p class="experience-education-metadata">University of Winnipeg · Completed 2023</p>
        <p>
          The degree established a foundation in software development, computing concepts, and
          structured problem-solving.
        </p>
      </article>
    </div>
  </section>

  <section id="skills" class="skills container" aria-labelledby="skills-title">
    <div class="skills-heading">
      <p class="section-label">Capabilities</p>
      <h2 id="skills-title">Skills</h2>
      <p>
        Skills are presented in evidence-based groups rather than as an exhaustive technology list.
      </p>
    </div>

    <div class="skills-grid">
      <article class="skill-evidence">
        <h3>Software development</h3>
        <p>
          Python supports MediCheck’s desktop application logic, workflow redesign, validation, and
          state lifecycle.
        </p>
        <p>
          JavaScript, React, and Flask support the EchoTask full-stack MVP, while Astro and
          TypeScript support this portfolio rebuild.
        </p>
      </article>

      <article class="skill-evidence">
        <h3>Data and relational systems</h3>
        <p>
          MySQL supports MediCheck’s relational visit records, SQL-driven historical suggestions,
          and transactional persistence.
        </p>
        <p>EchoTask uses SQLAlchemy and SQLite for relational data modeling and persistence work.</p>
      </article>

      <article class="skill-evidence">
        <h3>Workflow analysis and automation</h3>
        <p>
          My current role provides experience in analyzing workflows and developing small
          automation tools.
        </p>
        <p>
          EchoTask demonstrates how I translate operational workflow ideas into data structures and
          application responsibilities.
        </p>
      </article>

      <article class="skill-evidence">
        <h3>Technical operations and problem-solving</h3>
        <p>
          My IT Operations Analyst experience and Bachelor’s degree in Applied Computer Science
          support a practical approach to technical problem-solving.
        </p>
        <p>
          Independent software projects and the iterative rebuild of this portfolio provide further
          evidence of that approach.
        </p>
      </article>
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-major);
  }

  .hero-content {
    max-width: 60ch;
  }

  .section-label {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about {
    padding-top: var(--space-2xl);
  }

  .experience-education,
  .skills {
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border-strong);
  }

  .about {
    padding-bottom: var(--space-major);
    scroll-margin-top: var(--space-lg);
  }

  .about-content {
    max-width: 68ch;
  }

  .about h2 {
    margin: 0;
    font-size: var(--font-size-section);
    line-height: 1.15;
  }

  .about-introduction {
    max-width: 52ch;
    margin: var(--space-lg) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    line-height: 1.55;
  }

  .about-supporting {
    max-width: 68ch;
    margin-top: var(--space-xl);
    color: var(--color-text-secondary);
  }

  .about-supporting p {
    margin: 0;
  }

  .about-supporting p + p {
    margin-top: var(--space-md);
  }

  .projects {
    padding-block: var(--space-2xl) var(--space-section);
    background: var(--color-surface);
    box-shadow: 0 0 0 100vmax var(--color-surface);
    clip-path: inset(0 -100vmax);
    scroll-margin-top: var(--space-lg);
  }

  .projects-heading {
    max-width: 52ch;
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .projects h2,
  .projects h3,
  .projects h4 {
    margin: 0;
  }

  .projects h2 {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    line-height: 1.15;
  }

  .projects-introduction {
    margin: var(--space-lg) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    line-height: 1.55;
  }

  .medicheck {
    margin-top: var(--space-section);
    scroll-margin-top: var(--space-lg);
  }

  .medicheck-header {
    padding-inline-start: var(--space-lg);
    border-inline-start: 3px solid var(--color-accent);
  }

  .medicheck-header,
  .medicheck-summary,
  .medicheck-details {
    max-width: 68ch;
  }

  .medicheck h3 {
    color: var(--color-text);
    font-size: clamp(1.625rem, 2.5vw, 2rem);
    line-height: 1.2;
  }

  .project-metadata {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .project-metadata span {
    margin-inline: var(--space-2xs);
  }

  .medicheck-summary {
    margin-top: var(--space-xl);
    color: var(--color-text-secondary);
  }

  .medicheck-summary p {
    margin: 0;
  }

  .project-technology {
    margin-top: var(--space-md) !important;
    color: var(--color-text);
  }

  .medicheck-figure {
    max-width: 43.75rem;
    margin: var(--space-2xl) 0 0;
    padding: var(--space-sm);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .medicheck-figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .medicheck-figure figcaption {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.55;
  }

  .medicheck-details {
    margin-top: var(--space-2xl);
  }

  .medicheck-details section + section {
    margin-top: var(--space-xl);
  }

  .medicheck-details h4 {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .medicheck-details p {
    margin: var(--space-md) 0 0;
    color: var(--color-text-secondary);
  }

  .medicheck-action {
    margin-top: var(--space-2xl);
  }

  .echotask {
    margin-top: var(--space-major);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-subtle);
    scroll-margin-top: var(--space-lg);
  }

  .echotask h3 {
    color: var(--color-text-secondary);
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    line-height: 1.2;
  }

  .echotask-content {
    margin-top: var(--space-lg);
    color: var(--color-text-secondary);
  }

  .echotask-content p {
    margin: 0;
  }

  .echotask-text {
    max-width: 68ch;
  }

  .echotask-evidence {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .echotask-evidence h4 {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.3;
  }

  .echotask-evidence p {
    margin-top: var(--space-sm);
  }

  .echotask-action {
    margin-top: var(--space-xl);
  }

  .echotask-visuals {
    display: grid;
    gap: var(--space-xl);
    max-width: 60rem;
    margin-top: var(--space-2xl);
  }

  .echotask-figure {
    margin: 0;
    padding: var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .echotask-figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .echotask-figure figcaption {
    margin-top: var(--space-sm);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.55;
  }

  .experience-education {
    padding-bottom: var(--space-section);
    scroll-margin-top: var(--space-lg);
  }

  .experience-education h2,
  .experience-education h3,
  .experience-education h4 {
    margin: 0;
  }

  .experience-education h2 {
    font-size: var(--font-size-section);
    line-height: 1.15;
  }

  .experience-education-pair {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  .experience-education-entry {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface-subtle);
  }

  .experience-education-entry h3 {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
    line-height: 1.4;
  }

  .experience-education-entry h4 {
    margin-top: var(--space-md);
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .experience-education-metadata {
    margin: var(--space-sm) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 600;
  }

  .experience-education-entry > p:last-child {
    max-width: 52ch;
    margin: var(--space-md) 0 0;
    color: var(--color-text-secondary);
  }

  .skills {
    padding-bottom: var(--space-section);
    scroll-margin-top: var(--space-lg);
  }

  .skills-heading {
    max-width: 52ch;
  }

  .skills h2,
  .skills h3 {
    margin: 0;
  }

  .skills h2 {
    font-size: var(--font-size-section);
    line-height: 1.15;
  }

  .skills-heading p:not(.section-label) {
    margin: var(--space-lg) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    line-height: 1.55;
  }

  .skills-grid {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  .skill-evidence {
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .skill-evidence h3 {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .skill-evidence p {
    max-width: 52ch;
    margin: var(--space-md) 0 0;
    color: var(--color-text-secondary);
  }

  .eyebrow {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  h1 {
    margin: 0;
    font-size: var(--font-size-display);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero-summary {
    max-width: 52ch;
    margin: var(--space-lg) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    line-height: 1.55;
  }

  .hero-contact {
    scroll-margin-top: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .hero-contact ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-contact :is(a, button) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding-inline: var(--space-sm);
    border: 0;
    border-bottom: 2px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .hero-contact button {
    cursor: pointer;
  }

  .hero-contact li:first-child a {
    padding-inline-start: 0;
  }

  .hero-contact li + li {
    display: flex;
    align-items: center;
  }

  .hero-contact li + li::before {
    width: 1px;
    height: var(--space-lg);
    background: var(--color-border);
    content: '';
  }

  .hero-contact :is(a, button):hover {
    border-color: var(--color-accent-hover);
    color: var(--color-accent-hover);
  }

  .hero-contact :is(a, button):active {
    border-color: var(--color-accent-active);
    color: var(--color-accent-active);
    transform: translateY(1px);
  }

  .copy-email-status,
  .copy-email-fallback {
    max-width: 100%;
    margin: var(--space-sm) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    overflow-wrap: anywhere;
  }

  .copy-email-status:empty {
    display: none;
  }

  .copy-email-fallback span {
    user-select: text;
  }

  .action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
