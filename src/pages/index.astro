---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="YuShan Hung | Portfolio Rebuild"
  description="YuShan Hung's portfolio is being thoughtfully rebuilt."
>
  <section class="intro container" aria-labelledby="page-title">
    <p class="eyebrow">Portfolio rebuild</p>
    <h1 id="page-title">A new portfolio is in progress.</h1>
    <p class="summary">
      I’m building a clearer, more thoughtful home for my software projects and professional story.
      This temporary page confirms that the new Astro foundation is up and running.
    </p>
  </section>

  <section id="rebuild-status" class="status container" aria-labelledby="status-title">
    <h2 id="status-title">Foundation status</h2>
    <p>The structure, accessibility baseline, responsive styles, and production build are being established first.</p>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    align-content: center;
    min-height: min(70vh, 44rem);
    padding-block: var(--space-8);
  }

  .eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent);
    font-size: var(--font-size-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: var(--font-size-display);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .summary {
    max-width: 42rem;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .status {
    padding-block: var(--space-7);
  }

  .status p {
    max-width: 42rem;
    color: var(--color-text-muted);
  }
</style>
