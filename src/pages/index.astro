<script>
  const copyEmailButton = document.querySelector<HTMLButtonElement>('#copy-email');
  const copyEmailStatus = document.querySelector<HTMLElement>('#copy-email-status');
  const copyEmailFallback = document.querySelector<HTMLElement>('#copy-email-fallback');

  if (copyEmailButton && copyEmailStatus && copyEmailFallback) {
    const email = copyEmailButton.dataset.email;
    let resetTimer: number | undefined;
    let copyAttempt = 0;

    copyEmailButton.addEventListener('click', async () => {
      const currentAttempt = ++copyAttempt;

      if (resetTimer !== undefined) {
        window.clearTimeout(resetTimer);
        resetTimer = undefined;
      }

      copyEmailButton.textContent = 'Copy email';
      copyEmailStatus.textContent = '';

      try {
        if (!email || !navigator.clipboard?.writeText) {
          throw new Error('Clipboard access is unavailable.');
        }

        await navigator.clipboard.writeText(email);

        if (currentAttempt !== copyAttempt) return;

        copyEmailFallback.hidden = true;
        copyEmailButton.textContent = 'Email copied';
        copyEmailStatus.textContent = 'Email copied';

        resetTimer = window.setTimeout(() => {
          if (currentAttempt !== copyAttempt) return;

          copyEmailButton.textContent = 'Copy email';
          copyEmailStatus.textContent = '';
          resetTimer = undefined;
        }, 2500);
      } catch {
        if (currentAttempt !== copyAttempt) return;

        copyEmailButton.textContent = 'Copy email';
        copyEmailFallback.hidden = false;
        copyEmailStatus.textContent = 'Copy failed — select the email address';
      }
    });
  }
</script>
