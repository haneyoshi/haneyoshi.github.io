---
const navigation = [
  { href: '#main-content', label: 'Home' },
  { href: '#rebuild-status', label: 'Status' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-name" href="/" aria-label="YuShan Hung, home">YuShan Hung</a>
    <nav aria-label="Primary navigation">
      <ul class="navigation">
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4.5rem;
  }

  .site-name {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  .navigation {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .navigation a {
    color: var(--color-text-muted);
  }

  .navigation a:hover {
    color: var(--color-accent);
  }
}
</style>
